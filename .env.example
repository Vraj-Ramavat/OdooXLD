# GlobalTrotter Supabase Environment Variables
# Copy this file to .env or .env.local to connect to a live Supabase backend.
# Note: Omitting these variables will automatically fall back to the built-in LocalStorage Mock DB.

VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
